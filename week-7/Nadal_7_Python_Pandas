    "\n",
    "fig = px.bar(\n",
    "    segment_revenue,\n",
    "    x=\"Segment\",\n",
    "    y=\"Monetary\",\n",
    "    title=\"UrbanStyle kliendisegmentide kogukäive\",\n",
    "    text_auto=\".2f\"\n",
    ")\n",
    "\n",
    "fig.update_layout(\n",
    "    xaxis_title=\"Kliendisegment\",\n",
    "    yaxis_title=\"Kogukäive (€)\",\n",
    "    showlegend=False\n",
    ")\n",
    "\n",
    "fig.show()"
   ]
