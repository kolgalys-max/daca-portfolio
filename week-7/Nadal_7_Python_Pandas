    "\n",
    "rfm[\"F_Score\"] = pd.qcut(\n",
    "    rfm[\"Frequency\"].rank(method=\"first\"),\n",
    "    q=5,\n",
    "    labels=[1, 2, 3, 4, 5]\n",
    ").astype(int)\n",
    "\n",
    "rfm[\"M_Score\"] = pd.qcut(\n",
    "    rfm[\"Monetary\"],\n",
    "    q=5,\n",
    "    labels=[1, 2, 3, 4, 5]\n",
    ").astype(int)\n",
    "\n",
    "rfm[\"RFM_Score\"] = (\n",
    "    rfm[\"R_Score\"]\n",
    "    + rfm[\"F_Score\"]\n",
    "    + rfm[\"M_Score\"]\n",
    ")\n",
    "\n",
    "def assign_segment(score):\n",
    "    if score >= 13:\n",
    "        return \"VIP Champions\"\n",
    "    elif score >= 10:\n",
    "        return \"Loyal Customers\"\n",
    "    elif score >= 7:\n",
